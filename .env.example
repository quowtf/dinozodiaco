# --- Resend (envío de correo) -------------------------------------------
# API key con Full access (segments, topics, properties, broadcasts).
RESEND_API_KEY=re_xxxxxxxxxxxx

# Remitente. Debe ser un dominio verificado en Resend.
RESEND_FROM=predicciones@dinozodiaco.com
RESEND_FROM_NAME=Dinozodiaco

# --- Upstash Redis (contenido de las predicciones) -----------------------
# Base de datos Redis free. La prediccion de cada mes se guarda como
# JSON en la key `prediccion:YYYY-MM`.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx

# --- Cron ---------------------------------------------------------------
# Secreto que valida el endpoint POST /api/cron/predicciones.
# Generar con: openssl rand -hex 32
# El MISMO valor debe estar en GitHub Actions (secret CRON_SECRET).
CRON_SECRET=

# URL publica del sitio. Se usa para los links del correo.
SITE_URL=https://dinozodiaco.com

# --- Ventana de envio ---------------------------------------------------
# Hora local de envio, reloj de 24 h. El dia 1 de cada mes.
PREDICCIONES_HORA=18:06
PREDICCIONES_ZONA=America/Mexico_City
PREDICCIONES_DIA=1

# Prefijo de los segments de Resend: uno por signo + el maestro.
PREDICCIONES_SEGMENT_PREFIX=dinozodiaco
